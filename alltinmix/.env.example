# ============================================================================
#  Copy this file to ".env" (Docker, at the project root) or "backend/.env"
#  (running without Docker). Lines starting with # are comments.
# ============================================================================

# --- Core ---------------------------------------------------------------
NODE_ENV=production
POSTGRES_PASSWORD=change-me-to-a-long-random-password     # Docker only
# DATABASE_URL=postgres://user:pass@localhost:5432/alltinmix    # without Docker
JWT_SECRET=                      # REQUIRED, 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CLIENT_URL=https://YOURDOMAIN.com    # the public address of your site (used in emails and payment return links)
API_URL=https://YOURDOMAIN.com       # same address when using Docker/nginx (webhooks go to API_URL/api/webhooks/...)
REQUIRE_EMAIL_VERIFICATION=true

# --- Branding (this is how you white-label for each client) --------------
BRAND_NAME=ALLTINMIX
BRAND_TAGLINE=We bring you all your wants.
BRAND_LOGO_URL=/logo.png          # put the file in frontend/public/logo.png (or use a full https:// link)
BRAND_LOGO_PLATE=false           # true = logo on a white badge (for logos that vanish on a dark header)
BRAND_SHOW_NAME=true             # show the name next to the logo
BRAND_PRIMARY_COLOR="#111111"
BRAND_ACCENT_COLOR="#FEC107"
SUPPORT_EMAIL=support@YOURDOMAIN.com
CURRENCY_CODE=SLE                # Sierra Leonean Leone
CURRENCY_SYMBOL=Le
CURRENCY_DECIMALS=2
FX_RATES=USD:22.5                # other currencies buyers can pay in: how many Leones equal 1 unit. Admins can change this later. Example: USD:22.5,EUR:24
DEFAULT_COMMISSION_PCT=10
EMAIL_FROM=ALLTINMIX <no-reply@YOURDOMAIN.com>

# --- Email (required in production) ------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Payments -------------------------------------------------------------------
# Enable any of: stripe, flutterwave, paypal, momo  (comma separated). "mock" is for testing only.
PAYMENT_PROVIDERS=momo,paypal,stripe
CARD_PROVIDER=stripe             # stripe or flutterwave: which one handles "Credit / debit card"

# Orange Money / Afrimoney / QMoney (buyers send money to your numbers; you confirm in the admin panel).
# Leave a number empty to hide that method.
ORANGE_MONEY_NUMBER=
AFRIMONEY_NUMBER=
QMONEY_NUMBER=
MOMO_ACCOUNT_NAME=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox               # sandbox or live
PAYPAL_WEBHOOK_ID=

# Which currencies each payment method accepts (defaults shown). A method is hidden if none of its currencies is offered.
# MOMO_CURRENCIES=SLE              # Orange Money, Afrimoney, QMoney (set to SLE,USD if you also accept dollars on them)
# CARD_CURRENCIES=USD              # Stripe/Flutterwave. Check which currencies your provider account supports.
# PAYPAL_CURRENCIES=USD

# --- Optional tuning -----------------------------------------------------------
AUTO_COMPLETE_DAYS=7             # delivered orders release payment automatically after this many days
PAYMENT_EXPIRY_MINUTES=30
MIN_PAYOUT_MINOR=50000           # minimum withdrawal in minor units (50000 = Le 500.00)
WEB_PORT=8080                    # Docker: port the site is published on

# Mobile app store rules: Apple requires in-app purchase for digital goods sold inside an app.
# Set to false to hide "Digital downloads" everywhere (recommended if you publish the iOS app).
ALLOW_DIGITAL_GOODS=true

# --- Local delivery and payment -------------------------------------------------
COD_ENABLED=true                 # cash on delivery for physical items (the seller collects cash; the platform fee is charged to their balance)
COD_MAX_MINOR=0                  # largest cash-on-delivery order in minor units (0 = no limit)
COD_SELLER_DEBT_LIMIT_MINOR=5000000   # a seller who owes more than this (Le 50,000.00) cannot take new COD orders until they settle
DELIVERY_ZONES=                  # optional start list, "Area:fee,Area:fee" in whole Leones. Admins edit it later in Admin > Overview
PHONE_COUNTRY_CODE=232           # lets local numbers like 077... become +23277...

# SMS / WhatsApp alerts for new orders and status changes (off by default)
SMS_PROVIDER=none                # none | twilio | webhook
SMS_CHANNEL=sms                  # sms | whatsapp (Twilio WhatsApp needs approved templates outside a 24h chat window)
# SMS_FROM=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SMS_WEBHOOK_URL=               # any local gateway: we POST {"to","message","channel"} as JSON
# SMS_WEBHOOK_TOKEN=

# Seller growth
BOOST_PRICE_MINOR=0              # price of promoting a listing, in minor units (Le 5 = 500). 0 turns promotions off
BOOST_DAYS=7                     # how long one promotion lasts
PRIVATE_DIR=./private            # where seller ID photos are kept. Never expose this folder publicly
