# Local development only (no Docker). Copy to backend/.env.  Production uses the root .env.example.
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/alltinmix
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:4000
REQUIRE_EMAIL_VERIFICATION=false
# 'mock' adds a fake "Test payment" button that moves no money. It is refused in production.
PAYMENT_PROVIDERS=mock
BRAND_NAME=ALLTINMIX
BRAND_LOGO_URL=/logo.png
ALLOW_DIGITAL_GOODS=true
